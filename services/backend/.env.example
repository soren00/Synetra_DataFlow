# Synetra_DataFlow 后端部署环境配置模板（复制为 .env 并填写）。
# 位于 backend/.env，已 gitignore，不入库。

# 服务监听
SYNETRA_HOST=0.0.0.0
SYNETRA_PORT=8000

# 元数据/日志库（元数据、血缘、审计、运行记录）。
# 格式：mysql://user:password@host:port/dbname?charset=utf8mb4
# 留空则回退到本地 SQLite（data_dir/synetra.db），便于无数据库的本地开发/测试。
SYNETRA_METADATA_DB_DSN=mysql://root:12345@127.0.0.1:3306/synetra